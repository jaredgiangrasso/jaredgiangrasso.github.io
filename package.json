{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.12",
    "@fortawesome/free-brands-svg-icons": "^5.6.3",
    "@fortawesome/free-solid-svg-icons": "^5.6.3",
    "astro": "^7.4.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:live": "playwright test -c playwright.live.config.ts",
    "predeploy": "npm run check && npm test",
    "deploy": "gh-pages -t -o pages -b master -d dist",
    "postdeploy": "node scripts/wait-for-deploy.ts && npm run test:live"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "gh-pages": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  }
}
