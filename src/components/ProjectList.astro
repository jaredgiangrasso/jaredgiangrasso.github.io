---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<main class="card-viewer">
  {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
</main>

<style>
  /* Projects flow in the document (no inner scroll container), so wheel, keyboard,
     and touch scrolling work anywhere on the page. */
  .card-viewer {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    grid-area: cards;
    padding-top: 10%;
    padding-bottom: 10%;
    z-index: 1;
  }

  @media only screen and (max-width: 900px) {
    /* Starts below the fixed 240px mobile header. */
    .card-viewer {
      padding: 0;
      padding-top: 240px;
    }
  }

  @media only screen and (max-width: 600px) {
    .card-viewer {
      padding-top: 210px;
    }
  }
</style>
