---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<main class="card-viewer" aria-label="Projects">
  <!-- role="list": Safari drops list semantics when list-style is none. -->
  <ol class="card-list" role="list">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </ol>
</main>

<style>
  /* Projects flow in the document (no inner scroll container), so wheel, keyboard,
     and touch scrolling work anywhere on the page. */
  .card-viewer {
    position: relative;
    grid-area: cards;
    padding-top: 10%;
    padding-bottom: 10%;
    z-index: 1;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media only screen and (max-width: 900px) {
    .card-viewer {
      padding: 0;
    }
  }
</style>
