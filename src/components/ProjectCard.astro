---
import { getImage } from "astro:assets";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { name, tools, description, still, demoLink, gitLink } = project;

// The card's one link: the demo, else the source. With neither, the card isn't linked.
const href = demoLink ?? gitLink;
const number = `#${String(index + 1).padStart(3, "0")}`;

// Rendered at ~41vw on desktop and ~77vw on mobile (85% of the card's width).
const sizes = "(max-width: 900px) 77vw, 41vw";
const widths = [400, 600, 800, 1200, 1600];
const eager = index === 0;
const image = await getImage({ src: still, widths, sizes });
---

<li class:list={["card", { linked: !!href }]}>
  <div class="card-header">
    <h2 class="project-title">
      {
        href ? (
          <a class="card-link" href={href} target="_blank" rel="noreferrer noopener">
            {name}{" "}
            <span class="visually-hidden">(opens in new tab)</span>
          </a>
        ) : (
          name
        )
      }
    </h2>
    <span class="card-index" aria-hidden="true">{number}</span>
  </div>

  <!-- Decorative: the title already names the project, and the whole card is the link. -->
  <img
    class="screen"
    src={image.src}
    srcset={image.srcSet.attribute}
    sizes={sizes}
    width={still.width}
    height={still.height}
    style={`aspect-ratio: ${still.width} / ${still.height}`}
    alt=""
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />

  <div class="card-footer">
    <div class="project-info">
      <p class="tools">{tools}</p>
      <p class="description">{description}</p>
    </div>
    {
      gitLink && (
        <a
          class="github-icon"
          href={gitLink}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={`${name} on GitHub (opens in new tab)`}
        >
          <Icon icon={faGithub} size="3x" />
        </a>
      )
    }
  </div>
</li>

<style>
  .card {
    position: relative;
    width: 80%;
    margin-top: 10%;
    margin-bottom: 5%;
    /* Contents flow top to bottom, so they can grow (zoom, text spacing) without overlapping. */
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(10px, 1.25vw, 18px);
    border-radius: 20px;

    background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.05));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.35);

    transition:
      transform 180ms ease-out,
      box-shadow 180ms ease-out,
      border-color 180ms ease-out,
      background 180ms ease-out;
    z-index: 1;
  }

  /* Only linked cards respond to hover; keyboard focus gets the same treatment plus a ring. */
  .card.linked:hover,
  .card:has(.card-link:focus-visible) {
    box-shadow: 0 26px 60px rgba(15, 23, 42, 0.5);
    border-color: rgba(255, 255, 255, 0.8);
    background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0.08));
  }

  .card:has(.card-link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card.linked:hover,
    .card:has(.card-link:focus-visible) {
      transform: translateY(-4px);
    }
  }

  .card-header,
  .card-footer {
    width: 85%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .card-header {
    margin-bottom: 18px;
    font-size: 18px;
    font-weight: 700;
  }

  .project-title {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    color: #020617;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card, so the card is one click target and one tab stop. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 20px;
    z-index: 1;
  }

  /* The ring goes around the whole card instead (see above). */
  .card-link:focus-visible {
    outline: none;
  }

  .card-index {
    color: #475569;
  }

  .screen {
    display: block;
    width: 85%;
    height: auto;
    border-radius: 16px;
    filter: drop-shadow(2px 5px 5px rgb(15, 23, 42, 0.4));
  }

  .card-footer {
    align-items: flex-end;
    margin-top: clamp(8px, 1.9vw, 27px);
  }

  .project-info {
    min-width: 0;
    color: #020617;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.45);
  }

  /* Stack line */
  .tools {
    margin: 0;
    font-size: 15px;
    font-weight: normal;
  }

  /* Description line */
  .description {
    margin: 0;
    margin-bottom: 2px;
    font-size: 20px;
    font-weight: bold;
  }

  /* Above the stretched card link. The padding/negative margin give a ≥24px tap target
     without changing how big the icon looks. */
  .github-icon {
    position: relative;
    z-index: 2;
    flex: none;
    display: inline-flex;
    padding: 4px;
    margin: -4px;
    font-size: 13px;
    color: #020617;
  }

  @media only screen and (max-width: 1200px) {
    .description {
      font-size: 15px;
    }

    .tools {
      font-size: 12px;
    }

    .github-icon {
      font-size: 10px;
    }
  }

  @media only screen and (max-width: 900px) {
    .card {
      margin-top: 5%;
      width: 90%;
    }

    .github-icon {
      font-size: 9px;
    }
  }

  /* Text never shrinks below 12–14px, so zooming always makes it bigger. */
  @media only screen and (max-width: 600px) {
    .description {
      font-size: 14px;
    }

    .github-icon {
      font-size: 8px;
    }
  }
</style>
